<Window  x:Class="test_819.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="Prism 异步进度示例" Height="200" Width="500"
        xmlns:converters="clr-namespace:test_819.Converters"
       >

    <Window.Resources>
        <!-- 注册转换器，给它一个 Key，方便在 XAML 中引用 -->
        <converters:BoolToTextConverter x:Key="BoolToText" />
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 进度条 -->
        <ProgressBar Grid.Row="0" 
                     Minimum="0" Maximum="100" 
                     Value="{Binding ProgressValue}" 
                     Height="30" 
                     Foreground="Green" 
                     Background="LightGray"/>

        <!-- 百分比文字显示 -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding ProgressValue, StringFormat='当前进度：{0}%'}" 
                   FontSize="16" 
                   HorizontalAlignment="Center" 
                   Margin="0,10,0,10"/>

        <!-- 启动按钮（IsEnabled 自动绑定到 !IsBusy） -->
        <Button Grid.Row="2" 
    Content="{Binding IsBusy, Converter={StaticResource BoolToText}, FallbackValue=开始任务}" 
        Command="{Binding StartCommand}" 
        Width="120" Height="40" HorizontalAlignment="Center"/>
    </Grid>
</Window>